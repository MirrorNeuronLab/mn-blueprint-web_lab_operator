{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "service",
  "mode": "compiled",
  "job_name": "web-lab-operator",
  "requirements": {
    "cpu": {
      "min_cores": 4
    },
    "memory": {
      "min_gb": 8
    },
    "disk": {
      "min_gb": 50
    },
    "gpu": {
      "min_count": 1,
      "min_memory_mb": 49152,
      "memory_operator": ">=",
      "enforcement": "hard",
      "vendor": "nvidia",
      "driver": "cuda"
    },
    "network": {
      "egress": "Image preparation downloads Isaac Sim, Ubuntu and Python packages. The live scene uses local assets."
    },
    "os": "linux"
  },
  "agents": {
    "registry": {}
  },
  "defaults": {
    "worker": {
      "uses": "mn-agents.worker.python_docker@1",
      "with": {
        "stereotype": [
          "blueprint_docker_worker",
          "internal_write_worker"
        ],
        "docker_worker_image": "docker_worker",
        "image": "mirror-neuron/web-lab-operator:3.0.0",
        "dockerfile": "docker_worker/Dockerfile",
        "build_context": ".",
        "workdir": "/app",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          },
          {
            "source": "isaac",
            "target": "isaac"
          },
          {
            "source": "web_assets",
            "target": "web_assets"
          }
        ],
        "python_executable": "/opt/mn-venv/bin/python3",
        "gpus": "all"
      }
    }
  },
  "service": {
    "enabled": true,
    "run_until": "manual_stop",
    "state_artifact": "equipment_state.json",
    "manual_close": "Pause or stop the co-worker in OtterDesk to shut down the workcell."
  }
}
