{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "summary": "Observed state and recent manual actions in the live Isaac Sim workcell.",
  "input_adapters": {
    "default": "json",
    "supported": [
      "json",
      "file",
      "env_json"
    ],
    "resolved_artifact": "inputs.json"
  },
  "inputs": {
    "supervisor_instructions": {
      "type": "array",
      "required": false,
      "privacy": "confidential",
      "maxItems": 50,
      "description": "Chat explanation preferences only. Procedure changes require a new run.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "kind": {
            "enum": [
              "communication"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "outputs": {
    "profile": "standard_run_store",
    "primary": {
      "id": "equipment_state",
      "path": "equipment_state.json",
      "schema_version": "mn.web_lab.state.v1",
      "type": "service_result",
      "required_fields": [
        "schema_version",
        "status",
        "frame",
        "revision",
        "observed_at",
        "motion",
        "joints",
        "inspection_light",
        "recent_actions"
      ]
    }
  },
  "privacy": {
    "classification": "internal",
    "external_sharing": "disabled",
    "notes": "The Job workspace streams the simulated workcell only. The service stores the latest equipment state and recent manual actions."
  }
}
