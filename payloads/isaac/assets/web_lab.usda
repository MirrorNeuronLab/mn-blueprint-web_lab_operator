#usda 1.0
(
    defaultPrim = "World"
    doc = "Live MK3 food-dye dilution workcell in Isaac Sim."
    endTimeCode = 120
    framesPerSecond = 30
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 30
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def Xform "Cell" (
        prepend references = @./dilution_station.usda@
    )
    {
    }

    def Scope "Looks"
    {
        def Material "Stand"
        {
            token outputs:surface.connect = </World/Looks/Stand/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.084, 0.119, 0.14)
                float inputs:metallic = 0.17
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "Backdrop"
        {
            token outputs:surface.connect = </World/Looks/Backdrop/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.028, 0.046, 0.066)
                float inputs:metallic = 0
                float inputs:roughness = 0.67
                token outputs:surface
            }
        }
    }

    def Cube "Pedestal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </World/Looks/Stand>
        color3f[] primvars:displayColor = [(0.084, 0.119, 0.14)]
        double size = 1
        float3 xformOp:scale = (0.886, 0.695, 0.096)
        double3 xformOp:translate = (0, -0.015, -0.048)
