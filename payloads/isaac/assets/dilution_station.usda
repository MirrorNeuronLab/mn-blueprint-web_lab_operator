#usda 1.0
(
    defaultPrim = "Cell"
    doc = "MK3 demonstration cell. The gantry, labware, and read markers are scoped to the simulated dye sample."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cell" (
    kind = "component"
    prepend references = @./vendor/mk3_cell.usdc@
)
{
    def Scope "Looks"
    {
        def Material "Rack"
        {
            token outputs:surface.connect = </Cell/Looks/Rack/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.036, 0.11, 0.12)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.44
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </Cell/Looks/Rubber/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.026, 0.033)
                float inputs:metallic = 0
                float inputs:roughness = 0.52
                token outputs:surface
            }
        }

        def Material "TipMetal"
        {
            token outputs:surface.connect = </Cell/Looks/TipMetal/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.79, 0.78)
                float inputs:metallic = 0.71
                float inputs:roughness = 0.29
                token outputs:surface
            }
        }

        def Material "Vessel"
        {
            token outputs:surface.connect = </Cell/Looks/Vessel/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.82, 0.83)
                float inputs:metallic = 0
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "VesselWall"
        {
            token outputs:surface.connect = </Cell/Looks/VesselWall/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.79, 0.88, 0.93)
                float inputs:metallic = 0
                float inputs:opacity = 0.3
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }

        def Material "TipDye"
        {
            token outputs:surface.connect = </Cell/Looks/TipDye/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008, 0.035, 0.34)
                float inputs:metallic = 0
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }

        def Material "ReadLight"
        {
            token outputs:surface.connect = </Cell/Looks/ReadLight/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.7, 0.56)
                color3f inputs:emissiveColor = (0.05, 0.56, 0.39)
                float inputs:metallic = 0
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Label"
        {
            token outputs:surface.connect = </Cell/Looks/Label/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.18, 0.22)
                color3f inputs:diffuseColor.connect = </Cell/Looks/Label/Atlas.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }

            def Shader "ReadUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Atlas"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./sample_labels.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Cell/Looks/Label/ReadUV.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def Xform "SampleTray"
    {
        def Cube "Riser" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            rel material:binding = </Cell/Looks/Rubber>
            color3f[] primvars:displayColor = [(0.015, 0.026, 0.033)]
            double size = 1
            float3 xformOp:scale = (0.534, 0.145, 0.004)
            double3 xformOp:translate = (0, -0.115, 0.0645)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Carrier" (
