#usda 1.0
(
    defaultPrim = "DilutionStation"
    doc = "Simulated dye dilution station with a staged pipette and four open vessels. Measurements are illustrative."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DilutionStation" (
    kind = "group"
)
{
    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </DilutionStation/Looks/Steel/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.46, 0.54)
